rules_version = '2';
// 전자음악수호대 Firestore 보안 규칙
// 선생님: 처음 구글로 로그인해 meta/owner를 차지한 계정. 학생: 익명 로그인.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }

    // 지휘본부 계정: 한 번 정해지면 바꿀 수 없음(콘솔에서만 삭제)
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // 작전(방): 선생님만 열고 바꿈
    match /rooms/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // 모둠: 선생님이 만들고, 리더·대원이 코드·빠르기 등을 고침
    match /groups/{id} {
      allow read: if signedIn();
      allow create, delete: if isTeacher();
      allow update: if signedIn();
    }

    // 채널(학생 자리와 악보)
    match /tracks/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isTeacher();
    }
  }
}
